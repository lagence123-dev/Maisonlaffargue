# Apache 2.2
<IfModule !mod_authz_core.c>
    <FilesMatch "^(?!connector\.php$).+\.php$">
        order allow,deny
        deny from all
    </FilesMatch>
</IfModule>

# Apache 2.4
<IfModule mod_authz_core.c>
    <FilesMatch "^(?!connector\.php$).+\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>