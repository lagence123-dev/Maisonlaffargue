{% block dwfproductextrafields_image_widget %}
  {% block form_help %}{% endblock %}

  <div class="row">
    <div class="col-lg-6 mb-2">
      {{ form_widget(form, {'attr': attr}) }}
    </div>

  {% if data is not empty and data.webPath is defined %}
    <div class="col-lg-6 mb-2">
      <figure class="figure">
        {{ data.webPath|raw }}
        <figcaption class="figure-caption">
          <p>{{ 'File size'|trans({}, 'Admin.Advparameters.Feature') }} {{ data.size }}</p>
          <a class="btn btn-outline-primary btn-sm"
            href="{{ path('admin_products_edit', {'productId': app.request.get('productId'), 'deleteExtraFieldImage': form.vars.name }) }}#tab-product_dwfproductextrafields-tab"
            type="button"
          >
            <i class="material-icons">
              delete_forever
            </i>
            {{ 'Delete'|trans({}, 'Admin.Actions') }}
          </a>
        </figcaption>
      </figure>
    </div>
  {% endif %}
  </div>
{% endblock %}
